# NVIDIA Proxy — variáveis de ambiente
# Copie para .env e preencha. NUNCA versione o .env real.

# ── Obrigatório: API keys da NVIDIA NIM (ao menos 1) ─────────────
NVIDIA_API_KEY_1=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NVIDIA_API_KEY_2=...
# ... até NVIDIA_API_KEY_10 (o pool usa todas as que existirem)

# ── Modelo padrão (obrigatório no Docker; menu interativo no host) ──
# Valores válidos: moonshotai/kimi-k3, z-ai/glm-5.3,
# nvidia/nemotron-3-super-120b-a12b, nvidia/nemotron-3.5-lightning-30b-a3b,
# deepseek-ai/deepseek-v4.1-flash, z-ai/glm-5.3-flash
PROXY_MODEL=z-ai/glm-5.3

# ── Opcionais (defaults mostrados) ───────────────────────────────
# Porta do host no compose (a API responde em http://127.0.0.1:<esta porta>)
#PROXY_PORT=5000
# RPM por key
#PROXY_RPM=39
# Burst por key
#PROXY_BURST=39
# Timeout de leitura entre chunks (s)
#PROXY_READ_TIMEOUT=120
# Orçamento de espera por request (s)
#PROXY_WAIT_BUDGET=10
# Servidor: auto (waitress) | flask (werkzeug dev)
#PROXY_SERVER=auto
# No host interativo sem PROXY_MODEL, o menu pergunta. Forçar flask dev:
#PROXY_SERVER=flask
